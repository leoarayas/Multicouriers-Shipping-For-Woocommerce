{
    "name": "clevers/clevers-shipping-for-multicouriers",
    "description": "Multicouriers Shipping for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "lint": "find . -path './vendor' -prune -o -path './.git' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:legacy": "php tests/run-all.php",
        "phpstan": "phpstan analyse -c phpstan.neon --no-progress"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    }
}
